# Für die Entwicklung ohne Docker (pnpm dev). Kopieren nach apps/api/.env
DATABASE_URL=postgres://planspiel:planspiel@localhost:5432/planspiel
JWT_SECRET=nur-fuer-die-entwicklung
PORT=8787
# 1 = Demo-Kurs mit Testkonten (helen@demo.de ist Admin), 0 = leer
DEMO_DATEN=1
# Optional: eigenes Admin-Konto
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORT=

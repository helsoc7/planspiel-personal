# Einstellungen für docker compose. Kopieren nach .env und anpassen: cp .env.example .env
# Die .env gehört nicht ins Git-Repository (steht in .gitignore).

# --- Pflicht für echte Kurse ---------------------------------------------------

# Nur für den Server (docker-compose.prod.yml): Adresse, unter der die App läuft.
# Ein DNS-A-Eintrag dieser Adresse muss auf den Server zeigen, sonst gibt es kein HTTPS-Zertifikat.
DOMAIN=
# E-Mail für Let's Encrypt (Hinweise zu ablaufenden Zertifikaten), optional
ACME_EMAIL=

# Schlüssel für die Anmeldung, mindestens 32 Zeichen. Erzeugen mit: openssl rand -hex 32
# Ohne sicheren Schlüssel startet die API nur im Demo-Betrieb (DEMO_DATEN=1).
JWT_SECRET=

# Passwort der Datenbank. Gilt nur beim allerersten Start (leeres Volume).
# Später ändern heißt: auch in der Datenbank ändern, sonst verbindet sich die API nicht mehr.
POSTGRES_PASSWORT=planspiel

# Admin-Konto: wird beim Start angelegt, falls es noch nicht existiert. Nur der Admin legt Kurse an.
# Ein bestehendes Konto mit dieser E-Mail wird zum Admin, sein Passwort bleibt unverändert.
ADMIN_EMAIL=
ADMIN_NAME=
# mindestens 12 Zeichen, nur für das erste Anlegen nötig
ADMIN_PASSWORT=

# --- Betrieb -------------------------------------------------------------------

# 1 = Demo-Kurs mit Testkonten anlegen (helen@demo.de / planspiel ist dann Admin!), 0 = leer starten
# Auf dem Server wird das ignoriert: docker-compose.prod.yml startet immer ohne Demodaten.
DEMO_DATEN=1

# Port der Weboberfläche auf diesem Rechner
WEB_PORT=8080
# Port der Datenbank auf diesem Rechner (nur lokal erreichbar)
DB_PORT=5432

# Nur für den Server: Wie viele Tage nächtliche Datenbank-Sicherungen aufbewahrt werden
BACKUP_TAGE=14

# --- Nur bei Bedarf ------------------------------------------------------------
# Andere Basis-Images, z. B. aus einer eigenen Registry
# NODE_IMAGE=node:22-slim
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2-alpine
# Netzwerk beim Bauen der Images (z. B. host, wenn das Standardnetz keinen Internetzugang hat)
# BUILD_NETWORK=default
